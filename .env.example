# Local development only. Supply a unique password; do not commit .env.
POSTGRES_USER=career
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=career
WEB_PORT=8080
API_PORT=8000
# For a locally running API, start PostgreSQL with compose.dev.yaml.
DATABASE_URL=postgresql+asyncpg://career:replace-with-local-password@127.0.0.1:5432/career
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=2
DB_READY_TIMEOUT=3
ENVIRONMENT=development
# Generate three INDEPENDENT values, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CSRF_SECRET=
RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://127.0.0.1:4200"]
# Development Docker edge only; restrict to the actual edge subnet/address in production.
TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]
