FROM ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a AS uv
# Debian base: Playwright publishes Chromium builds and Python wheels for glibc only.
FROM python:3.13.16-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
WORKDIR /srv/api

FROM base AS dependencies
COPY --from=uv /uv /uvx /bin/
ENV UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --group browser --no-cache

FROM base AS runtime
COPY --from=dependencies /srv/api/.venv ./.venv
# Headless shell only, with just the shared libraries it links against (no X server, fonts,
# or print stack from Playwright's broader --with-deps list).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libdbus-1-3 \
        libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libx11-6 libxcb1 libxcomposite1 \
        libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 \
    && .venv/bin/playwright install --only-shell chromium \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 app && useradd -u 10001 -g app -M -d /tmp -s /usr/sbin/nologin app \
    && python -m pip uninstall --yes pip
COPY app ./app
USER app:app
ENV HOME=/tmp
CMD [".venv/bin/celery", "-A", "app.workers.celery_app:celery", "worker", "--loglevel", "INFO", "-Q", "extraction-browser", "--concurrency", "1", "--prefetch-multiplier", "1"]
